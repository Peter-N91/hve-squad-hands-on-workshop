@model OrderListViewModel
@{
    ViewBag.Title = "Orders";
}
<h1>@Model.Customer.Name <small>(@Model.Customer.Code)</small></h1>
<p>Orders from the last @Model.HistoryMonths months.</p>
<table>
    <thead>
        <tr><th>Order</th><th>Date</th><th>Channel</th><th>Status</th><th>Total</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Orders)
        {
            <tr>
                <td>@Html.ActionLink(order.OrderNumber, "Details", new { id = order.Id })</td>
                <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                <td>@order.Channel</td>
                <td>@order.Status</td>
                <td>@order.Total.ToString("N2") EUR</td>
                <td>
                    @using (Html.BeginForm("Copy", "Orders", new { id = order.Id, customerId = Model.Customer.Id }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit">Copy to new order</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
